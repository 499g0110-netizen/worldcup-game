  <tag k="alt_name" v="Via regia"/>
  <tag k="description" v="Historischer Landtransportweg für Salz von Lüneburg nach Lübeck"/>
  <tag k="designation" v="altstrasse"/>
  <tag k="from" v="Lüneburg"/>
  <tag k="historic" v="road"/>
  <tag k="name" v="Alte Salzstraße - Via Regia"/>
  <tag k="note" v="Moderne Straßen bitte nur aufnehmen, wenn sie auf der (durch Karten belegten) historischen Trasse liegen. Lücken sind bewusst dort gelassen, wo die Trasse völlig verschwunden ist."/>
