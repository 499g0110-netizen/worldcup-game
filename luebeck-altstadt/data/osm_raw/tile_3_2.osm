  <tag k="artwork_type" v="installation"/>
  <tag k="description" v="Themengebiet: Nautik Theoriebezug: Optik Kann man einen Gegenstand, den man vergrößert betrachten will, nicht nahe heranholen, so muss man einen anderen Weg wählen, z.B. indem man durch ein Fernglas blickt."/>
  <tag k="image" v="http://commons.wikimedia.org/wiki/File:Jt_deu_hl_wissenschaft_fernrohr.JPG"/>
  <tag k="location" v="Breite Straße 6-8"/>
  <tag k="name" v="Wissenschaftspfad: Fernglas"/>
  <tag k="network" v="stadt_der_wissenschaft_2012"/>
  <tag k="ref" v="3"/>
  <tag k="stadtteil" v="Schlutup"/>
  <tag k="tourism" v="artwork"/>
  <tag k="website" v="http://www.wissen-luebeck.de/index.php/wissenschaftspfad/fernglas"/>
 </node>
 <node id="1617711078" visible="true" version="12" changeset="181809130" timestamp="2026-04-25T14:28:56Z" user="didi53fahrrad" uid="1761083" lat="53.8726986" lon="10.6891961">
  <tag k="artwork_type" v="installation"/>
  <tag k="description" v="Themengebiet: Natur Theoriebezug: Akustik Die Geräusche, die wir hören, sind das Ergebnis eines Verarbeitungsprozesses, den Schallwellen bzw. Töne hervorrufen. In unseren Ohren lösen sie Signale aus, die über Nervenfasern zum Gehirn geleitet werden."/>
  <tag k="image" v="http://commons.wikimedia.org/wiki/File:Jt_deu_hl_wissenschaft_h%C3%B6rmuschel.JPG"/>
  <tag k="location" v="Kleine Burgstraße / Kleine Altefähre"/>
  <tag k="name" v="Wissenschaftspfad: Hörmuschel"/>
  <tag k="network" v="stadt_der_wissenschaft_2012"/>
  <tag k="ref" v="2"/>
  <tag k="stadtteil" v="Kücknitz"/>
  <tag k="tourism" v="artwork"/>
  <tag k="website" v="http://www.wissen-luebeck.de/index.php/wissenschaftspfad/hoermuschel"/>
 </node>
