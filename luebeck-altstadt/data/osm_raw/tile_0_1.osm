  <tag k="description" v="Former outer bridge in front of the second town gate of the Holstein-gate. / The bridge's replica statues and vases of Dietrich Jürgen Boy's original sandstone sculptures from 1774 - 76 were integrated into the newly constructed bridge from 1907."/>
  <tag k="description:de" v="Ehemalige äußere Brücke vor dem zweiten Vortor des Holstentores. Von der alten Brücke die 1774 - 76 von Dietrich Jürgen Boy aus Sandstein gefertigten allegorischen Standfiguren und Vasen in den Neubau von 1907 übernommen."/>
  <tag k="information" v="board"/>
  <tag k="internet_access" v="no"/>
  <tag k="name" v="Puppenbrücke"/>
  <tag k="tourism" v="information"/>
 </node>
