  <tag k="alt_name" v="Via regia"/>
  <tag k="description" v="Historischer Landtransportweg für Salz von Lüneburg nach Lübeck"/>
  <tag k="designation" v="altstrasse"/>
  <tag k="from" v="Lüneburg"/>
  <tag k="historic" v="road"/>
